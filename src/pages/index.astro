---
import '@/styles/global.css'
import Theme from '@/components/Theme.astro'
import { Screen } from '@/components/Screen'
import { Preview } from '@/components/Preview'
import { Actions } from '@/components/Actions'
import { CalcButtons } from '@/components/CalcButtons'
---

<html lang='es'>
	<head>
		<meta charset='utf-8' />
		<link rel='icon' type='image/svg+xml' href='/favicon.svg' />
		<link rel='icon' href='/favicon.ico' />
		<meta name='viewport' content='width=device-width' />
		<title>Calculadora (zalk) - mAngo (Ubiufboeuf)</title>
		<link rel='preload' href='/Inter.woff2' as='font' type='font/woff2' crossorigin />
		<script is:inline>
			function getCookie (cookie) {
				return document.cookie
          .split('; ')
					.find((c) => c.startsWith(`${cookie}=`))
					?.split('=')
					?.[1]
			}
			
			const savedTheme = getCookie('zalk-theme')
			document.documentElement.setAttribute('data-theme', savedTheme ?? '')
		</script>
	</head>
	<body class='w-full h-full flex flex-col items-center'>
		<header class='h-14 w-full flex items-center justify-end px-4 p-1'>
			<Theme />
		</header>
		<main class='h-[calc(100%-56px)] w-auto aspect-9/19.5 flex flex-col justify-between'>
			<Screen client:load />
			<Preview client:load />
			<Actions client:load />
			<CalcButtons client:load />
		</main>
	</body>
</html>
