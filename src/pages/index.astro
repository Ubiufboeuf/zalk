---
import { Result } from '@/components/calc/Result';
import Layout from '../layouts/Layout.astro';
import { CalcButtons } from '@/components/calc/CalcButtons';
import { Input } from '@/components/calc/Input';
import { ActionButtons } from '@/components/calc/ActionButtons';
---

<Layout class='flex justify-center'>
  <!-- <main class='grid grid-rows-[auto_auto_auto_1px_1fr] h-full max-w-full aspect-9/19.5'> -->
  <main class='flex flex-col justify-end h-full max-w-full aspect-9/19.5'>
    <div class='row-1'>
      <!-- <Input client:load /> -->
    </div>

    <div class='row-2'>
      <!-- <Result client:load /> -->
    </div>

    <div class='row-3'>
      <ActionButtons client:load />
    </div>

    <div class='row-4'>
      <div class='w-full h-fit px-4 py-3'>
        <div class='w-full h-px bg-base-content/20' />
      </div>
    </div>
    
    <div class='row-5'>
      <CalcButtons client:load />
    </div>
  </main>
</Layout>

<style>
  main {
    background-image: url('/calc.jpg');
    background-position: center center;
    background-size: contain;
    background-repeat: no-repeat;
  }
</style>