---
import { Result } from '@/components/calc/Result';
import Layout from '../layouts/Layout.astro';
import { CalcButtons } from '@/components/calc/CalcButtons';
import { Operation } from '@/components/calc/Operation';
import { ActionButtons } from '@/components/calc/ActionButtons';
---

<Layout class='flex justify-center'>
  <main class='flex flex-col justify-end h-full max-w-full aspect-9/19.5 overflow-hidden'>
    <Operation client:load />
    <Result client:load />
    <ActionButtons client:load />

    <div class='w-full h-fit px-4 py-3'>
      <div class='w-full h-px bg-base-content/20' />
    </div>

    <CalcButtons client:load />
  </main>
</Layout>

<style>
  main {
    /* background-image: url('/calc2.jpg'); */
    background-position: center center;
    background-size: contain;
    background-repeat: no-repeat;
  }
</style>